export default async function handler(req, res) {

  if (req.method !== "POST") {
    return res.status(405).json({
      reply: "Only POST requests are allowed."
    });
  }

  const message = (req.body?.message || "").trim();
  const mode = req.body?.mode || "chat";

  // =========================
  // TEMPORARY DEBUG LOG
  // =========================

  console.log("Bablu AI mode:", mode);

  if (!message) {
    return res.status(400).json({
      reply: "मुझे कोई message भेजो 😊"
    });
  }

  /* =========================
     OPENROUTER API KEY
     ========================= */

  const apiKey = process.env.OPENROUTER_API_KEY;

  if (!apiKey) {
    return res.status(500).json({
      reply: "OPENROUTER_API_KEY Vercel में सेट नहीं है।"
    });
  }


  /* =========================
     REAL AI IMAGE GENERATION
     ========================= */

  if (mode === "image") {

    console.log("Bablu AI: IMAGE branch started");

    try {

      const response = await fetch(
        "https://openrouter.ai/api/v1/images",
        {
          method: "POST",

          headers: {
            "Authorization": `Bearer ${apiKey}`,
            "Content-Type": "application/json",
            "HTTP-Referer": "https://bablu-ai.vercel.app",
            "X-Title": "Bablu AI"
          },

          body: JSON.stringify({
            model: "recraft/recraft-v3:free",
            prompt: message
          })
        }
      );

      const data = await response.json();

      console.log(
        "OpenRouter Image Response:",
        data
      );

      if (!response.ok) {

        return res.status(response.status).json({
          reply:
            data?.error?.message ||
            "Image generate नहीं हो पाई।"
        });
      }

      const image =
        data?.data?.[0]?.b64_json;

      if (!image) {

        return res.status(500).json({
          reply:
            "OpenRouter ने image data नहीं भेजा।"
        });
      }

      return res.status(200).json({

        type: "image",

        image: image,

        mimeType:
          data?.data?.[0]?.media_type ||
          "image/png"

      });

    } catch (error) {

      console.error(
        "OpenRouter Image Error:",
        error
      );

      return res.status(500).json({
        reply:
          "Image server से connection नहीं हो पाया।"
      });
    }
  }


  /* =========================
     AI CHAT
     ========================= */

  try {

    const response = await fetch(
      "https://openrouter.ai/api/v1/chat/completions",
      {
        method: "POST",

        headers: {
          "Authorization":
            `Bearer ${apiKey}`,

          "Content-Type":
            "application/json",

          "HTTP-Referer":
            "https://bablu-ai.vercel.app",

          "X-Title":
            "Bablu AI"
        },

        body: JSON.stringify({

          model:
            "openrouter/free",

          messages: [

            {
              role: "system",

              content:
                "You are Bablu AI, a helpful, friendly and intelligent AI assistant. Answer clearly and naturally. If the user speaks Hindi, reply in Hindi."
            },

            {
              role: "user",

              content:
                message
            }

          ]
        })
      }
    );

    const data =
      await response.json();

    console.log(
      "OpenRouter Chat Response:",
      data
    );

    if (!response.ok) {

      return res.status(response.status).json({
        reply:
          data?.error?.message ||
          "AI से जवाब नहीं मिला।"
      });
    }

    const reply =
      data?.choices?.[0]?.message?.content ||
      "मुझे जवाब नहीं मिला।";

    return res.status(200).json({

      type: "text",

      reply:
        reply

    });

  } catch (error) {

    console.error(
      "OpenRouter Chat Error:",
      error
    );

    return res.status(500).json({
      reply:
        "Server से connection नहीं हो पाया।"
    });
  }

}
